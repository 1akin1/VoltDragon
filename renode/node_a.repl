// Node A board: the common STM32F407 platform plus the sensors on its I2C1 bus.
using "./stm32f407.repl"

// LSM9DS1 IMU with SDO_AG and SDO_M tied high (see firmware/node_a/src/lsm9ds1.h).
imu: Sensors.LSM9DS1_IMU @ i2c1 0x6B

mag: Sensors.LSM9DS1_Magnetic @ i2c1 0x1E

// MT25Q 128 Mbit (16 MiB) flight-data flash on SPI1. PA4 drives its chip select:
// raising it ends the current command, as on the real part.
spiflash: SPI.Micron_MT25Q @ spi1
    underlyingMemory: spiflash_mem

spiflash_mem: Memory.MappedMemory
    size: 0x1000000

gpioPortA:
    4 -> spiflash@0
