:name: VoltDragon Node B
:description: Single STM32F407 node running the Node B (gateway) firmware.
:
: Usage (from the repository root):
:   renode renode/node_b.resc
:
: USART2 is the debug console, USART3 the operator command interface.
: Override the firmware with:  $bin_b=@path/to/node_b.elf  before including this script.

$bin_b?=$ORIGIN/../build/debug/firmware/node_b/node_b.elf

using sysbus
mach create "node_b"
machine LoadPlatformDescription $ORIGIN/stm32f407.repl

# Honour SCB_CCR.DIV_0_TRP so integer division by zero traps as on silicon.
nvic FilterCcrDiv0Write false

showAnalyzer sysbus.usart2
showAnalyzer sysbus.usart3

# A reset reloads the firmware but keeps RAM, so the .noinit reset record survives.
macro reset
"""
    sysbus LoadELF $bin_b
"""
runMacro $reset
