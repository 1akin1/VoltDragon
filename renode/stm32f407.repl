// VoltDragon node platform: Renode's STM32F4 model, adjusted to our clock tree.
using "platforms/cpus/stm32f4.repl"

// The firmware runs from the 16 MHz HSI (no PLL). The stock model clocks
// SysTick at 72 MHz, which would make the 1 ms tick run 4.5x too fast.
nvic:
    systickFrequency: 16000000

// The UART models derive their baud rate from BRR and this clock; the stock
// default of 8 MHz would halve every baud rate the firmware configures (a
// 9600 baud GPS would deliver 4800 baud).
usart1:
    frequency: 16000000

usart2:
    frequency: 16000000

usart3:
    frequency: 16000000

uart4:
    frequency: 16000000

uart5:
    frequency: 16000000
